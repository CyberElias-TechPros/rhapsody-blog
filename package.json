{
  "name": "rhapsody-blog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rhapsody of Realities \u2014 every daily devotional, published as a static Next.js blog. Cloudflare Worker API in /worker.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:extract": "node scripts/extract-devotionals.mjs",
    "content:verify": "node scripts/extract-devotionals.mjs --verify",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "content:kids": "node scripts/extract-kids.mjs",
    "content:kids:verify": "node scripts/extract-kids.mjs --verify",
    "content:kids:report": "node scripts/extract-kids.mjs --report"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.462.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^20.0.3",
    "pdf-to-img": "^7.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
