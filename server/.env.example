# Server
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/meaning
CLIENT_ORIGIN=http://localhost:8080

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Telegram channels (comma-separated usernames, no @)
TELEGRAM_CHANNELS=rhapsody_of_realities,PastorChrisOyakhilomeMessageText,pastorchrisbooks,rhapsodylibrary,classicgospelmusic

# Sync schedule (cron). Default: every 15 min
SYNC_CRON=*/15 * * * *

# Initial admin (created on first boot if no admin exists)
ADMIN_EMAIL=admin@meaning.app
ADMIN_PASSWORD=ChangeMe!2025
