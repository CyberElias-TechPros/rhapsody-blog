# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
# Next only exposes NEXT_PUBLIC_* to the browser.

# NEXT_PUBLIC_SITE_URL — canonical public origin, used for canonical/og:url, sitemap.xml
# and the RSS feed. No trailing slash.
#   Example: https://rhapsody-blog.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NEXT_PUBLIC_API_URL — absolute base URL of the deployed Cloudflare Worker API, including
# /api. Leave it empty in local development and set WORKER_DEV_URL instead (below) so the
# browser keeps talking to a single origin.
#   Example: https://meaning-api.<your-subdomain>.workers.dev/api
NEXT_PUBLIC_API_URL=

# WORKER_DEV_URL — dev-only. When set, next.config.ts rewrites same-origin /api/* and
# /media/* to the local wrangler dev server:
#   WORKER_DEV_URL=http://127.0.0.1:8787 npm run dev
WORKER_DEV_URL=

# ── Google AdSense ─────────────────────────────────────────────────────────────
# The loader script alone switches on Auto ads. Manual units need a slot id each:
# AdSense → Ads → By ad unit → Create new ad unit → Responsive → copy the data-ad-slot value.
# An empty slot id means that position renders nothing (no empty box, no layout shift).

# NEXT_PUBLIC_ADSENSE_CLIENT — publisher id from the AdSense snippet.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-9117572925263537

# NEXT_PUBLIC_ADS_ENABLED — leave unset to serve ads in production only. Set to `true` to check
# placements on a dev/preview server, or `false` to keep a staging deploy ad-free (clicking your
# own ads is an AdSense policy violation).
NEXT_PUBLIC_ADS_ENABLED=

# In-feed units: home grid, /devotionals, edition day lists, search results.
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
# Below-the-article units on /devotionals/<slug>.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# Bottom of standalone pages such as /about.
NEXT_PUBLIC_ADSENSE_SLOT_PAGE=

# ── The site's own clock ───────────────────────────────────────────────────────
# "Today" is counted in this zone, not in UTC and not at build time: the home page, /today,
# /api/today and the daily email all read it. A daily devotional that resolves its date in the
# wrong zone serves yesterday's article every evening.
#   Any IANA name — Africa/Lagos, Europe/London, America/New_York.
#   A value this runtime does not recognise falls back to Africa/Lagos rather than failing.
NEXT_PUBLIC_SITE_TIMEZONE=Africa/Lagos

# NEXT_PUBLIC_PUBLISH_HOUR — the hour, in the site zone, the day's devotional is considered
# published (05:00 as printed in the edition). Before it, the home page offers the previous day.
NEXT_PUBLIC_PUBLISH_HOUR=5

# ── Listening (text to speech) ─────────────────────────────────────────────────
# Audio works with none of this set: the browser's own voices read the article aloud, offline,
# for free. These keys upgrade it to a studio voice — the player switches over by itself.

# NEXT_PUBLIC_TTS_PROVIDER — `browser` (default), `openai` or `elevenlabs`.
# A value that is not one of those falls back to `browser` and logs why, so a typo cannot take
# audio down.
NEXT_PUBLIC_TTS_PROVIDER=browser

# NEXT_PUBLIC_TTS_VOICE / NEXT_PUBLIC_TTS_MODEL — defaults per provider are in lib/env.ts
# (`gideon` + `gpt-4o-mini-tts` for OpenAI, `Rachel` + `eleven_multilingual_v2` for ElevenLabs).
NEXT_PUBLIC_TTS_VOICE=
NEXT_PUBLIC_TTS_MODEL=

# Server-only: read by POST /api/tts, never shipped to the browser. With no key the endpoint
# answers 503 with a reason and the player stays on the browser voice.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=
#   https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ── The daily email (Cloudflare Worker, not this app) ──────────────────────────
# Set in worker/.dev.vars for local development and with `wrangler secret put` in production —
# see worker/.dev.vars.example. The frontend has no email code at all: it answers GET /api/today
# and the Worker's 04:00 UTC cron reads that, renders the article and sends it to the list.
