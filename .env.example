# Frontend environment (Vite exposes only VITE_* to the browser).
#
# VITE_API_URL — absolute base URL of the deployed Worker API, including /api.
#   Leave unset for local dev: Vite proxies same-origin /api to the wrangler
#   dev server (see vite.config.ts).
#   Example (production): https://meaning-api.<your-subdomain>.workers.dev/api
VITE_API_URL=

# VITE_SITE_URL — canonical public origin of this frontend, used for
# canonical/og:url meta tags. No trailing slash.
#   Example: https://meaning.vercel.app
VITE_SITE_URL=
