# Copy to `.dev.vars` for local development (never commit .dev.vars).
# In production set these with `wrangler secret put <NAME>`.

# Secret used to sign JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-please-replace-with-at-least-32-bytes

# Token lifetime (jose duration string), e.g. 12h, 7d
JWT_EXPIRES_IN=7d

# Bootstrap administrator — created on first run if no admin exists.
# Leave ADMIN_PASSWORD unset to skip admin creation entirely.
ADMIN_EMAIL=admin@meaning.app
ADMIN_PASSWORD=ChangeMe!2025-Strong-Enough

# Optional: public base URL for R2 media when served through a custom domain.
# When unset, media is served from this Worker under /media/*.
# MEDIA_PUBLIC_URL=https://media.example.com

# The deployed frontend origin (not this Worker's URL). The daily digest asks it what
# today's devotional is: GET {SITE_URL}/api/today?full=1. In local dev, `next dev` on :3000.
# Left empty, the digest skips with a log line instead of guessing a site to read from.
SITE_URL=http://localhost:3000

# Daily digest email. All three must be set or nothing is sent (by design — the subscriber
# list keeps growing in D1 either way, so switching email on later is a secret, not a migration).
# EMAIL_API_URL takes a Resend-shaped POST ({from,to,subject,html,text,headers}) with a
# Bearer key — https://api.resend.com/emails is the intended value.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM="Rhapsody of Realities <devotional@your-domain>"
