{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meaning-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "logpush": false,
  "observability": {
    "enabled": true
  },
    "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meaning-db",
      "database_id": "local-dev",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMITS",
      "id": "local-dev-kv"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "meaning-media"
    }
  ],
  "triggers": {
    // Two crons, told apart by the expression Cloudflare passes to `scheduled()`:
    //   */15 * * * *  Telegram sync
    //   0 4 * * *     daily digest email — 04:00 UTC is 05:00 in Lagos, the site's own
    //                 timezone, one hour after the day rolls over (src/services/digest.ts).
    "crons": ["*/15 * * * *", "0 4 * * *"]
  },
  "vars": {
    // Origins allowed to call this API from a browser. localhost:3000 is `next dev`;
    // *.vercel.app covers branch previews. Add the production domain before deploying.
    "ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,*.vercel.app",
    // The deployed FRONTEND origin (not this Worker's). The daily digest fetches
    // GET {SITE_URL}/api/today?full=1 from here, and misc routes build absolute post links
    // with it. Empty until it is set — the digest then skips rather than guessing a site.
    "SITE_URL": "",
    "MAX_UPLOAD_BYTES": "5242880",
    // Outbound email for the digest. Set EMAIL_API_URL and EMAIL_FROM here; EMAIL_API_KEY is
    // a secret — `wrangler secret put EMAIL_API_KEY`. All three, or nothing is sent.
    "EMAIL_API_URL": "",
    "EMAIL_FROM": ""
  },
  "placement": {
    "mode": "smart"
  }
}
